    conn = pymysql.connect(**db_config)
    cursor = conn.cursor()
    where = "p.status='approved'"
    params = []
    if current_username:
        where = f"(p.seller = %s OR p.status='approved')"
        params = [current_username]
    if q:
        where += f" AND (p.name LIKE %s OR p.description LIKE %s)"
        params.extend([f'%{q}%', f'%{q}%'])
    count_sql = f"SELECT COUNT(*) FROM products p WHERE {where}"
    cursor.execute(count_sql, params)
    total = cursor.fetchone()[0]
    sql = f"""
        SELECT p.id, p.name, p.price, p.description, p.seller, p.status, p.contact,
               p.sold_status, p.sold_time, p.created_at, p.type, p.desc_image,
               p.contact_image, u.nickname as seller_nickname
        FROM products p
        LEFT JOIN users u ON p.seller = u.username
        WHERE {where}
        ORDER BY p.id DESC LIMIT %s OFFSET %s
