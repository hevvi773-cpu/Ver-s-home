@app.route('/evaluate/<int:pid>', methods=['GET', 'POST'])
def evaluate(pid):
    if 'username' not in session or session.get('identity') != 'student':
        return redirect('/login_page')
    conn = pymysql.connect(**db_config)
    cursor = conn.cursor()
    cursor.execute("""
        SELECT p.seller, p.confirm_code, p.sold_status, p.name, u.nickname
        FROM products p
        LEFT JOIN users u ON p.seller = u.username
        WHERE p.id=%s
    """, (pid,))
    product = cursor.fetchone()
    if not product or product[2] != 'sold':
        cursor.close()
        conn.close()
        return "商品未售出或不存在", 404
    seller_username, confirm_code, sold_status, product_name, seller_nickname = product
    if session['username'] == seller_username:
        cursor.close()
        conn.close()
        return "不能评价自己的商品", 403
    cursor.execute("SELECT id FROM evaluations WHERE product_id=%s", (pid,))
    if cursor.fetchone():
        cursor.close()
        conn.close()
        return "该商品已被评价", 403
    if request.method == 'POST':
        code = request.form.get('confirm_code')
        rating = request.form.get('rating', type=int)
        content = request.form.get('content', '')
        if code != confirm_code:
            return render_template_string(EVALUATE_TEMPLATE, error='确认码错误',
                                          product=(product_name, seller_nickname or seller_username), pid=pid)
        if not rating or rating < 1 or rating > 5:
            return render_template_string(EVALUATE_TEMPLATE, error='评分须为1~5',
                                          product=(product_name, seller_nickname or seller_username), pid=pid)
        cursor.execute(
            "INSERT INTO evaluations (product_id, from_user, to_user, rating, content) VALUES (%s, %s, %s, %s, %s)",
            (pid, session['username'], seller_username, rating, content))
        conn.commit()
        cursor.close()
        conn.close()
        return redirect('/')
    cursor.close()
    conn.close()
    return render_template_string(EVALUATE_TEMPLATE, error=None,
                                  product=(product_name, seller_nickname or seller_username), pid=pid)


