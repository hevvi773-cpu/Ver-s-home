# ==================== 基础路由（登录、注册、登出等） ====================

@app.route('/login_page')
def login_page():
    return render_template_string(LOGIN_TEMPLATE, error=None, msg=None)


@app.route('/do_login', methods=['POST'])
def do_login():
    username = request.form.get('username')
    password = request.form.get('password')
    conn = pymysql.connect(**db_config)
    cursor = conn.cursor()
    cursor.execute("SELECT username, password, role, nickname, student_id FROM users WHERE username=%s", (username,))
    user = cursor.fetchone()
    cursor.close()
    conn.close()
    if user and user[1] == password:
        session['username'] = user[0]
        session['identity'] = user[2]
        session['nickname'] = user[3] if user[3] else user[0]
        if user[2] == 'student' and not user[4]:
            return redirect('/fill_student_id')
        if user[2] == 'admin':
            return redirect('/admin')
        return redirect('/')
    else:
        return render_template_string(LOGIN_TEMPLATE, error='用户名或密码错误', msg=None)


@app.route('/do_register', methods=['POST'])
def do_register():
    username = request.form.get('username')
    password = request.form.get('password')
    confirm = request.form.get('confirm_password')
    nickname = request.form.get('nickname')
    if not username or not password:
        return render_template_string(LOGIN_TEMPLATE, error='学号和密码不能为空', msg=None)
    if password != confirm:
        return render_template_string(LOGIN_TEMPLATE, error='两次密码不一致', msg=None)
    if not nickname:
        return render_template_string(LOGIN_TEMPLATE, error='昵称必须填写', msg=None)
    valid, msg = validate_student_id(username)
    if not valid:
        return render_template_string(LOGIN_TEMPLATE, error=msg, msg=None)
    conn = pymysql.connect(**db_config)
    cursor = conn.cursor()
    cursor.execute("SELECT id FROM users WHERE username=%s", (username,))
    if cursor.fetchone():
        cursor.close()
        conn.close()
        return render_template_string(LOGIN_TEMPLATE, error='该学号已被注册，请直接登录', msg=None)
    try:
        cursor.execute(
            "INSERT INTO users (username, password, nickname, role, student_id) VALUES (%s, %s, %s, 'student', %s)",
            (username, password, nickname, username))
        conn.commit()
        msg = f'注册成功！欢迎 {nickname}，请登录'
        cursor.close()
        conn.close()
        return render_template_string(LOGIN_TEMPLATE, error=None, msg=msg)
    except Exception as e:
        conn.rollback()
        cursor.close()
        conn.close()
        return render_template_string(LOGIN_TEMPLATE, error=f'注册失败: {str(e)}', msg=None)


@app.route('/logout')
def logout():
    session.clear()
    return redirect('/login_page')


@app.route('/fill_student_id', methods=['GET', 'POST'])
def fill_student_id():
    if 'username' not in session or session.get('identity') != 'student':
        return redirect('/login_page')
    if request.method == 'POST':
        student_id = request.form.get('student_id')
        if not student_id or not re.match(r'^20\d{13}$', student_id):
            return render_template_string(FILL_TEMPLATE, error='学号格式错误，须为15位数字且以20开头')
        conn = pymysql.connect(**db_config)
        cursor = conn.cursor()
        cursor.execute("SELECT id FROM users WHERE student_id=%s AND username!=%s", (student_id, session['username']))
        if cursor.fetchone():
            cursor.close()
            conn.close()
            return render_template_string(FILL_TEMPLATE, error='该学号已被其他账号使用')
        cursor.execute("UPDATE users SET student_id=%s WHERE username=%s", (student_id, session['username']))
        conn.commit()
        cursor.close()
        conn.close()
        return redirect('/')
    return render_template_string(FILL_TEMPLATE, error=None)


@app.route('/publish')
def publish_page():
    if session.get('identity') != 'student':
        return redirect('/login_page')
    conn = pymysql.connect(**db_config)
