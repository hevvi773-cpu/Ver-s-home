@app.route('/admin')
@admin_required
def admin_panel():
    conn = pymysql.connect(**db_config)
    cursor = conn.cursor()

    q = request.args.get('q', '').strip()
    page = request.args.get('page', 1, type=int)
    per_page = 10
    offset = (page - 1) * per_page
    where = "1=1"
    params = []
    if q:
        where += " AND (name LIKE %s OR description LIKE %s)"
        params.extend([f'%{q}%', f'%{q}%'])
    cursor.execute(f"SELECT COUNT(*) FROM products WHERE {where}", params)
    total = cursor.fetchone()[0]
    sql = f"""
        SELECT id, name, price, description, seller, status, contact, sold_status,
               sold_time, created_at, type, desc_image, contact_image
        FROM products WHERE {where}
        ORDER BY id DESC LIMIT %s OFFSET %s
    """
    cursor.execute(sql, params + [per_page, offset])
    products_raw = cursor.fetchall()
    total_pages = (total + per_page - 1) // per_page
    products = []
    for p in products_raw:
        products.append({
            'id': p[0], 'name': p[1], 'price': p[2], 'description': p[3],
            'seller': p[4],
            'status': p[5], 'status_cn': STATUS_MAP.get(p[5], p[5]),
            'contact': p[6] or '', 'sold_status': p[7],
            'sold_status_cn': SOLD_STATUS_MAP.get(p[7], p[7]), 'type': p[10],
            'type_cn': TYPE_MAP.get(p[10], '出售'),
            'created_at': p[9].strftime('%Y-%m-%d %H:%M') if p[9] else '',
            'sold_time': p[8].strftime('%Y-%m-%d %H:%M') if p[8] else '',
            'desc_image': p[11] or '', 'contact_image': p[12] or ''
        })

    # 用户数据
    cursor.execute("SELECT id, username, nickname, role, DATE_FORMAT(ban_until, '%%Y-%%m-%%d %%H:%%i'), student_id FROM users")
    users = cursor.fetchall()

    # 统计
    cursor.execute("SELECT COUNT(*) FROM products"); total_count = cursor.fetchone()[0]
    cursor.execute("SELECT COUNT(*) FROM products WHERE status='pending'"); pending_count = cursor.fetchone()[0]
    cursor.execute("SELECT COUNT(*) FROM products WHERE status='approved'"); approved_count = cursor.fetchone()[0]
    cursor.execute("SELECT COUNT(*) FROM products WHERE sold_status='sold'"); sold_count = cursor.fetchone()[0]
    cursor.execute("SELECT COUNT(*) FROM users WHERE role='student'"); student_count = cursor.fetchone()[0]
    cursor.execute("SELECT COUNT(*) FROM users WHERE role='admin'"); admin_count = cursor.fetchone()[0]
    user_count = student_count + admin_count

    today = datetime.now().replace(hour=0, minute=0, second=0)
    cursor.execute("SELECT COUNT(*) FROM products WHERE created_at >= %s", (today,))
    today_new = cursor.fetchone()[0]

    # 近7天数据
    date_labels = []
    daily_counts = []
    daily_amounts = []
    daily_regs = []
    daily_evals = []
    active_days = []
    for i in range(6, -1, -1):
        day = datetime.now() - timedelta(days=i)
        date_str = day.strftime('%m-%d')
        date_labels.append(date_str)
        start = day.replace(hour=0, minute=0, second=0)
        end = day.replace(hour=23, minute=59, second=59)
        cursor.execute("SELECT COUNT(*) FROM products WHERE created_at BETWEEN %s AND %s", (start, end))
        daily_counts.append(cursor.fetchone()[0])
        cursor.execute("SELECT IFNULL(SUM(price),0) FROM products WHERE sold_status='sold' AND sold_time BETWEEN %s AND %s", (start, end))
        daily_amounts.append(float(cursor.fetchone()[0]))
        cursor.execute("SELECT COUNT(*) FROM users WHERE created_at BETWEEN %s AND %s", (start, end))
        daily_regs.append(cursor.fetchone()[0])
        cursor.execute("SELECT COUNT(*) FROM evaluations WHERE created_at BETWEEN %s AND %s", (start, end))
        daily_evals.append(cursor.fetchone()[0])
        active_days.append({'date': date_str, 'reg': daily_regs[-1], 'pub': daily_counts[-1], 'eval': daily_evals[-1]})

    # 交易额排行
    cursor.execute("""
        SELECT seller, COUNT(*) AS cnt, IFNULL(SUM(price),0) AS total
        FROM products
        WHERE sold_status='sold'
        GROUP BY seller
        ORDER BY total DESC
        LIMIT 5
    """)
    top_users = [{'seller': r[0], 'total_count': r[1], 'total_amount': float(r[2])} for r in cursor.fetchall()]

    # 反馈数据（含 image，时间在 Python 格式化）
    cursor.execute("""
        SELECT id, username, title, content, status, reply, created_at, image
        FROM feedbacks
        ORDER BY created_at DESC
    """)
    feedbacks = []
    for row in cursor.fetchall():
        created_at = row[6].strftime('%Y-%m-%d %H:%M') if row[6] else ''
        feedbacks.append({
            'id': row[0], 'username': row[1], 'title': row[2], 'content': row[3],
            'status': row[4], 'reply': row[5], 'created_at': created_at, 'image': row[7] or ''
        })

    cursor.close()
    conn.close()

    current_user = session.get('nickname', session.get('username', '管理员'))

    return render_template_string(
        ADMIN_TEMPLATE,
        products=products,
        users=users,
        current_user=current_user,
        total_count=total_count,
        pending_count=pending_count,
        approved_count=approved_count,
        sold_count=sold_count,
        user_count=user_count,
        student_count=student_count,
        admin_count=admin_count,
        today_new=today_new,
        q=q,
        page=page,
        total_pages=total_pages,
        date_labels=date_labels,
        daily_counts=daily_counts,
        daily_amounts=daily_amounts,
        daily_regs=daily_regs,
        active_days=active_days,
        top_users=top_users,
        feedbacks=feedbacks
    )


