@app.route('/delete/<int:pid>')
def delete(pid):
    conn = pymysql.connect(**db_config)
    cursor = conn.cursor()
    cursor.execute("SELECT seller, status, desc_image, contact_image FROM products WHERE id=%s", (pid,))
    product = cursor.fetchone()
    if not product:
        cursor.close()
        conn.close()
        return redirect('/')
    seller, status, desc_img, contact_img = product
    can_delete = False
    if session.get('identity') == 'admin':
        can_delete = True
    elif session.get('identity') == 'student' and session.get('username') == seller and status == 'pending':
        can_delete = True
    if not can_delete:
        cursor.close()
        conn.close()
        return "无权限", 403
    for img in [desc_img, contact_img]:
        if img and os.path.exists(img):
            try:
                os.remove(img)
            except:
                pass
    cursor.execute("DELETE FROM products WHERE id=%s", (pid,))
    conn.commit()
    cursor.close()
    conn.close()
    return redirect('/admin' if session.get('identity') == 'admin' else '/')


