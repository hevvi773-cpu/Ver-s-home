            <div class="row mb-2"><div class="col-4 fw-bold">交易状态：</div><div class="col-8">${d.sold_status_text}</div></div>
            <div class="row mb-2"><div class="col-4 fw-bold">发布时间：</div><div class="col-8">${d.created_at}</div></div>`;
        if(d.sold_time) html+=`<div class="row mb-2"><div class="col-4 fw-bold">售出时间：</div><div class="col-8">${d.sold_time}</div></div>`;
        html+=`<div class="row mb-2"><div class="col-4 fw-bold">描述：</div><div class="col-8">${d.description||'无'}</div></div>`;
        if(d.desc_image) html+=`<div><img src="/${d.desc_image}" style="max-width:200px;border-radius:8px;"></div>`;
        if(d.contact_image) html+=`<div><img src="/${d.contact_image}" style="max-width:200px;border-radius:8px;"></div>`;
        if(d.confirm_code && d.is_seller) html+=`<div class="mt-2"><span class="badge bg-success">确认码：${d.confirm_code}</span></div>`;
        if(d.evaluation) {
            html += `<hr><div class="mt-3"><h6>⭐ 用户评价</h6>
                <p>评分：${'⭐'.repeat(d.evaluation.rating)} (${d.evaluation.rating}星)</p>
