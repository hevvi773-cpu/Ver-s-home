@app.route('/messages')
def messages_list():
    if 'username' not in session or session.get('identity') != 'student':
        return redirect('/login_page')
    username = session['username']
    conn = pymysql.connect(**db_config)
    cursor = conn.cursor()
    sql = """
        SELECT 
            CASE WHEN sender = %s THEN receiver ELSE sender END AS other_user,
            MAX(created_at) AS last_time,
            (SELECT content FROM messages WHERE (sender = %s AND receiver = other_user) OR (sender = other_user AND receiver = %s) ORDER BY created_at DESC LIMIT 1) AS last_msg,
            (SELECT COUNT(*) FROM messages WHERE receiver = %s AND sender = other_user AND is_read = 0) AS unread_count
        FROM messages
        WHERE sender = %s OR receiver = %s
        GROUP BY other_user
        ORDER BY last_time DESC
    """
    cursor.execute(sql, (username, username, username, username, username, username))
    conversations = []
    for row in cursor.fetchall():
        conversations.append({
            'other_user': row[0],
            'last_time': row[1].strftime('%m-%d %H:%M') if row[1] else '',
            'last_msg': row[2] or '',
            'unread_count': row[3] or 0
        })
    cursor.close()
    conn.close()
    return render_template_string(MESSAGES_TEMPLATE, conversations=conversations)


@app.route('/messages/<receiver>')
def chat_detail(receiver):
    if 'username' not in session or session.get('identity') != 'student':
        return redirect('/login_page')
    sender = session['username']
    if receiver == sender:
        return "不能与自己对话", 400
    conn = pymysql.connect(**db_config)
    cursor = conn.cursor()
    # 标记该会话中接收者为当前用户且未读的消息为已读
    cursor.execute("UPDATE messages SET is_read = 1 WHERE receiver = %s AND sender = %s AND is_read = 0",
                   (sender, receiver))
    conn.commit()
    cursor.execute("""
        SELECT sender, content, DATE_FORMAT(created_at, '%%m-%%d %%H:%%i') AS created_at
        FROM messages
        WHERE (sender = %s AND receiver = %s) OR (sender = %s AND receiver = %s)
        ORDER BY created_at ASC
    """, (sender, receiver, receiver, sender))
    messages = [{'sender': row[0], 'content': row[1], 'created_at': row[2]} for row in cursor.fetchall()]
    cursor.close()
    conn.close()
    return render_template_string(CHAT_DETAIL_TEMPLATE, receiver=receiver, messages=messages, current_user=sender)


